{
  "name": "onelink-desktop-demo",
  "private": true,
  "version": "0.3.2",
  "type": "module",
  "main": "electron/main.cjs",
  "description": "OneLinkAI desktop client configuration demo",
  "author": "OneLinkAI",
  "scripts": {
    "test": "node --test electron/*.test.cjs",
    "dev": "vite --host 0.0.0.0 --port 5174",
    "build": "node scripts/build-keychain.mjs && vite build",
    "icons": "node scripts/generate-app-icons.mjs",
    "desktop": "npm run build && electron .",
    "desktop:dev": "node scripts/desktop-dev.mjs",
    "desktop:check": "npm run build && electron . --smoke-test",
    "desktop:test-flow": "npm run build && electron . --flow-test",
    "desktop:test-persistence": "npm run build && node scripts/test-provider-persistence.mjs",
    "desktop:pack": "npm run build && electron-builder --dir",
    "desktop:verify-mac": "node scripts/verify-mac-package.mjs",
    "desktop:dist": "npm run build && electron-builder",
    "desktop:dist-mac-release": "node scripts/build-mac-release.mjs",
    "website:dev": "npm --prefix 官网 run dev",
    "website:build": "npm --prefix 官网 run build",
    "docs:dev": "npm --prefix product-docs run dev",
    "docs:build": "npm run docs:check && npm --prefix product-docs run build",
    "docs:preview": "npm --prefix product-docs run preview",
    "docs:test-browser": "node scripts/verify-product-docs.mjs",
    "docs:generate": "node scripts/generate-product-docs.mjs && node scripts/update-doc-capabilities.mjs",
    "docs:check": "node scripts/generate-product-docs.mjs --check && node scripts/update-doc-capabilities.mjs --check && node scripts/check-product-docs.mjs",
    "desktop:prepare-update": "node scripts/prepare-software-update.mjs",
    "desktop:verify-mac-update": "electron scripts/verify-mac-update.cjs"
  },
  "dependencies": {
    "@iarna/toml": "^2.2.5",
    "electron-updater": "6.8.3",
    "highlight.js": "11.12.0",
    "json5": "2.2.3",
    "jsonc-parser": "^3.3.1",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "semver": "^7.8.5",
    "socks": "^2.8.10",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "electron": "40.10.6",
    "electron-builder": "^26.0.0",
    "vite": "^6.1.0"
  },
  "build": {
    "appId": "cloud.onelinkai.desktop",
    "productName": "OneLinkAI",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/**/*",
      "src/assets/brand/**/*",
      "src/request-fields.json",
      "src/client-capabilities.json",
      "package.json",
      "src/client-effort-levels.json",
      "src/client-setting-notes.json"
    ],
    "asar": true,
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icons/mac-icon.icns",
      "target": [
        "dmg"
      ],
      "identity": "Shanghai Wanlian Easy Computing Technology Co., Ltd (7HHXUC392K)",
      "hardenedRuntime": true,
      "notarize": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "sign": "scripts/sign-mac-app.cjs"
    },
    "win": {
      "icon": "build/icons/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "icon": "build/icons/linux",
      "target": [
        "AppImage"
      ],
      "category": "Development"
    },
    "asarUnpack": [
      "electron/native/*.node"
    ],
    "afterPack": "scripts/prepare-mac-app.cjs",
    "publish": [
      {
        "provider": "generic",
        "url": "https://www.onelinkai.cloud/api/desktop-updates/stable",
        "useMultipleRangeRequest": false
      }
    ],
    "nsis": {
      "deleteAppDataOnUninstall": false
    }
  }
}
